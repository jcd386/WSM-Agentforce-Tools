        </connector>
    </assignments>
    <assignments>
        <description>Use the recipient records as the notification audience. This is the configured path.</description>
        <name>Set_Notify_Users_From_Records</name>
        <label>Set Notify Users From Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NotifyUserIds</assignToReference>
            <operator>Add</operator>
            <value>
