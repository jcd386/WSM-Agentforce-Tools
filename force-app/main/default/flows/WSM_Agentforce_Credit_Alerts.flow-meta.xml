    <assignments>
        <description>Load the configured percent thresholds for this card. Values come from active Digital Wallet Alert Threshold records, not from this flow. Adding an item to a collection with Add appends every element of the source collection.</description>
        <name>Assign_Thresholds</name>
        <label>Assign Thresholds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ThresholdValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Collect_Percent_Thresholds</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Find_Exceeded_Thresholds</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set the alert trigger type to be percent consumed.</description>
        <name>Assign_Type_Percent</name>
